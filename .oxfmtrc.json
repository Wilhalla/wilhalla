{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "ignorePatterns": [
    "**/dist/**",
    "**/.output/**",
    "**/*.gen.ts",
    "**/generated/**",
    "**/*.md",
    "**/*.json",
    "**/*.yml",
    "**/*.yaml",
    "**/*.html",
    "**/*.astro",
    "pnpm-lock.yaml"
  ]
}
