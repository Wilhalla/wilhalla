# Wilhalla website (TanStack Start). Run from apps/site; `just site/<recipe>` works from the repo root.

set shell := ["bash", "-euo", "pipefail", "-c"]

[private]
default:
    @just --list

# Install workspace dependencies (idempotent)
setup:
    cd ../.. && pnpm install --frozen-lockfile

# Start the dev server on http://localhost:3000 (all interfaces)
dev: setup
    jp dev --port 3000 -- pnpm --dir "{{justfile_directory()}}" exec vite dev --host 0.0.0.0 --port 3000

# Build the SSR bundle into .output/
build:
    pnpm run build

# Serve the production build
preview:
    HOST=0.0.0.0 pnpm run preview

# Typecheck, tests and build: what CI runs for this app
check:
    cd ../.. && just check site

test:
    pnpm run test

sync-map-overlays source='/home/jp/Downloads/transfer-16' output='public/map-overlays':
    ./scripts/sync-map-overlays.sh "{{source}}" "{{output}}"

generate-map-hover-overlays input='public/map-overlays/original' output='public/map-overlays/hover':
    ./scripts/generate-map-hover-overlays.sh "{{input}}" "{{output}}"

generate-map-caption-glows output='public/map-overlays/hover':
    ./scripts/generate-map-caption-glows.sh "{{output}}"

# Create a repo-wide worktree under .worktrees/<name>
worktree-add name *args:
    jp worktree add {{name}} {{args}}

worktree-rm name *args:
    jp worktree remove {{name}} {{args}}

clean:
    rm -rf .output .content-collections
