---
import { LinkList, LinkListItem } from "@wilhalla/ui/components/link-list";
import { layout, prose, typography } from "@wilhalla/ui/lib/typography";
import { cn } from "@wilhalla/ui/lib/utils";
import { Image } from 'astro:assets'
import { ImageIcon, Layers2, MessageCircle } from 'lucide-react'
import { archiveSmallThumbUrl, archiveThumbUrl } from '../lib/assetUrls'
import { formatArchiveDate } from '../lib/date'
import { archivePostPartHtml, archivePostPartLabel, archivePostSidebarImageSizes, archivePostSidebarThumbSizes, type ArchivePostReading } from '../lib/archivePostReading'
import { buildArchivePostRendering } from '../lib/archivePostRendering'
import LegacyHtmlImages from './LegacyHtmlImages.astro'

type Props = {
  reading: ArchivePostReading
}

const { reading } = Astro.props
const { displayPost: post, series, currentPostId } = reading
const { isSeries, parts, imageEntries, hasImages, sidebarImages } = await buildArchivePostRendering(post, series?.posts)
---
<!-- One grid for the whole post page: the text column, and the photos beside it on wide screens. -->
<article class={cn(layout.container, "grid gap-12 pt-10 pb-16 md:pt-14 lg:grid-cols-[minmax(0,1fr)_20rem] xl:gap-16")}>
  <div class="min-w-0">
    <header class="max-w-3xl border-b border-chalk pb-8">
      <p class={typography.eyebrow}>{formatArchiveDate(post)} · {post.time || 'tijd onbekend'} · door {post.author}</p>
      <h1 class={cn(typography.display, "mt-3 text-balance")}>{post.title}</h1>
      <p class={cn(typography.small, "m-0 mt-5 flex flex-wrap gap-x-5 gap-y-2 text-gravel")} aria-label={`${imageEntries.length} beelden, ${post.reactionCount} reacties${isSeries ? `, samengevoegde reeks van ${parts.length} berichten` : ''}`}>
        {isSeries && <span class="inline-flex items-center gap-1.5"><Layers2 className="size-4" aria-hidden="true" />{parts.length} delen</span>}
        <span class="inline-flex items-center gap-1.5"><ImageIcon className="size-4" aria-hidden="true" />{imageEntries.length} beelden</span>
        {post.reactionCount > 0 ? (
          <a class="inline-flex items-center gap-1.5 text-gravel underline decoration-chalk underline-offset-4 hover:text-obsidian" href="#reactions"><MessageCircle className="size-4" aria-hidden="true" />{post.reactionCount} reacties</a>
        ) : (
          <span class="inline-flex items-center gap-1.5"><MessageCircle className="size-4" aria-hidden="true" />geen reacties</span>
        )}
      </p>
    </header>

    {isSeries && (
      <nav class="max-w-[66ch] pt-8" aria-label="Delen van dit verhaal">
        <h2 class={cn(typography.eyebrow, "mb-3")}>Dit verhaal bestaat uit {parts.length} berichten</h2>
        <LinkList>
          {parts.map((part, index) => (
            <LinkListItem
              href={`/posts/${part.slug}/#part-${part.id}`}
              eyebrow={`${archivePostPartLabel(index, parts.length)} · ${formatArchiveDate(part)}${part.id === currentPostId ? ' · dit bericht' : ''}`}
              title={part.title}
            />
          ))}
        </LinkList>
      </nav>
    )}

    {parts.map((part, index) => (
      <section class="border-b border-chalk py-10 last:border-b-0" id={`part-${part.id}`}>
        {isSeries && (
          <header class="mb-6 max-w-[66ch]">
            <p class={typography.eyebrow}>{archivePostPartLabel(index, parts.length)} · {formatArchiveDate(part)} {part.time ? `· ${part.time}` : ''}</p>
            <h2 class={cn(typography.heading, "mt-2 text-balance")}>{part.title}</h2>
          </header>
        )}
        <div class={prose}>
          <LegacyHtmlImages html={archivePostPartHtml(part)} />
        </div>
      </section>
    ))}
  </div>

  {hasImages && (
    <aside class="min-w-0 lg:sticky lg:top-20 lg:max-h-[calc(100svh-6rem)] lg:self-start lg:overflow-y-auto" aria-label="Beelden in dit bericht">
      <div class="mb-4 flex items-baseline justify-between gap-4 border-b border-chalk pb-3">
        <h2 class={typography.subsection}>Foto's</h2>
        <p class={cn(typography.small, "m-0 text-gravel")}>{imageEntries.length.toLocaleString('nl-BE')}</p>
      </div>
      <div class="grid grid-cols-3 gap-1.5 sm:grid-cols-4 lg:grid-cols-3">
        {sidebarImages.map((image, index) => {
          const featured = index === 0
          const imageClass = cn(
            'h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03] motion-reduce:transition-none',
            featured ? 'aspect-4/3' : 'aspect-square',
          )
          return (
            <a class={cn('group block overflow-hidden rounded-md bg-powder', featured && 'col-span-3 sm:col-span-2 lg:col-span-3')} href={image.viewerHref} aria-label={`Open foto ${index + 1} in het beeldarchief`}>
              {image.metadata ? (
                <Image
                  class={imageClass}
                  src={featured ? archiveThumbUrl(image.src) : archiveSmallThumbUrl(image.src)}
                  width={featured ? 480 : 240}
                  height={featured ? 360 : 240}
                  sizes={featured ? archivePostSidebarImageSizes : archivePostSidebarThumbSizes}
                  alt=""
                  loading={index < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              ) : (
                <img class={imageClass} src={archiveSmallThumbUrl(image.src)} srcset={`${archiveSmallThumbUrl(image.src)} 240w, ${archiveThumbUrl(image.src)} 480w`} sizes={featured ? archivePostSidebarImageSizes : archivePostSidebarThumbSizes} alt="" loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
              )}
            </a>
          )
        })}
      </div>
    </aside>
  )}
</article>
