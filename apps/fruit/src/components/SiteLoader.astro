---
import { Spinner } from "@wilhalla/ui/components/spinner";
import { typography } from "@wilhalla/ui/lib/typography";
import { cn } from "@wilhalla/ui/lib/utils";

interface Props {
  id: string
  label: string
  message: string
}

const { id, label, message } = Astro.props
---
<!-- Fills the screen under the header while the page works; fades in late so a quick one never flashes. -->
<div
  id={id}
  class="grid min-h-below-navbar animate-in place-content-center justify-items-center gap-4 p-8 text-center delay-reveal duration-reveal ease-enter fill-mode-both fade-in"
  role="status"
  aria-live="polite"
  aria-label={label}
>
  <img class="size-28 bg-transparent object-contain" src="/apple-assets/apple-1-160.webp" alt="" aria-hidden="true" />
  <p class={typography.subsection}>Blogarchief Daniel Willaeys</p>
  <p class={cn(typography.small, "m-0 inline-flex items-center gap-2 text-gravel")}>
    <Spinner aria-hidden="true" />
    {message}
  </p>
</div>
