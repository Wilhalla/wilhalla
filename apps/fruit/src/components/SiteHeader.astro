---
import { layout } from "@wilhalla/ui/lib/typography";
import { buttonVariants } from "@wilhalla/ui/components/button";
import { cn } from "@wilhalla/ui/lib/utils";
import { Search, Shuffle } from "lucide-react";
import { siteNavigation } from "../lib/siteNavigation";
import SiteMobileMenu from "./SiteMobileMenu";

// Built like the Wilhalla site's navbar: brand, the links in the middle, the main action at the end.
const current = (href: string) =>
  href === "/" ? Astro.url.pathname === "/" : Astro.url.pathname.startsWith(href);
---
<header class="sticky top-0 z-50 w-full border-b border-chalk bg-eggshell/95 backdrop-blur-sm">
  <nav class={cn(layout.container, "grid h-navbar grid-cols-bar items-center")} aria-label="Hoofdnavigatie">
    <a class="inline-flex min-w-0 items-center gap-2 no-underline" href="/" data-astro-prefetch aria-label="Blogarchief Daniel Willaeys, naar de startpagina">
      <img class="size-6 bg-transparent object-contain" src="/apple-assets/apple-1-96.webp" alt="" loading="eager" decoding="async" />
      <span class="truncate font-heading text-heading-sm leading-none tracking-ui text-obsidian">Daniel Willaeys</span>
    </a>

    <ul class="m-0 hidden list-none items-center justify-center gap-1 p-0 xl:flex">
      {siteNavigation.map(({ href, label, Icon }) => (
        <li>
          <a class={buttonVariants({ variant: "ghost" })} href={href} aria-current={current(href) ? "page" : undefined} data-astro-prefetch>
            <Icon className="text-slate" strokeWidth={1.5} />{label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden items-center gap-1 justify-self-end xl:flex">
      <a class={buttonVariants({ variant: "ghost", size: "icon" })} href="/random/" aria-label="Open een willekeurig bericht" title="Willekeurig bericht">
        <Shuffle className="text-slate" strokeWidth={1.5} />
      </a>
      <a class={buttonVariants()} href="/search/" data-astro-prefetch>
        <Search strokeWidth={1.5} />Zoeken
      </a>
    </div>

    <div class="col-start-3 justify-self-end xl:hidden">
      <SiteMobileMenu client:load />
    </div>
  </nav>
</header>
