---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SearchApp from '../../components/search/SearchApp'
import categoriesData from '../../data/generated/categories.json'
import searchManifest from '../../data/generated/search-manifest.json'

const categories = categoriesData.categories.map(({ id, label, postCount }) => ({ id, label, postCount }))
---
<BaseLayout title="Zoeken · Blogarchief Daniël Willaeys" description="Zoek in het archief.">
  <SearchApp
    client:load
    categories={categories}
    postCount={searchManifest.postCount}
    chunks={searchManifest.chunks}
  />
</BaseLayout>
