---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostContent from '../../components/PostContent.astro'
import ReactionList from '../../components/ReactionList'
import FurtherReading from '../../components/FurtherReading'
import { archiveAssetUrl } from '../../lib/assetUrls'
import { buildArchivePostReading } from '../../lib/archivePostReading'
import { postIndex } from '../../lib/postIndex'

export function getStaticPaths() {
  return postIndex.map((post) => ({ params: { slug: post.slug } }))
}

const reading = buildArchivePostReading(Astro.params.slug ?? '')
if (!reading) return Astro.redirect('/archive/')
const { displayPost } = reading
const postSocialImage = displayPost.images[0] ? archiveAssetUrl(displayPost.images[0]) : undefined
const postDescription = displayPost.excerpt || displayPost.title
---
<BaseLayout
  title={`${displayPost.title} · Blogarchief Daniël Willaeys`}
  description={postDescription}
  image={postSocialImage}
  imageAlt={`Foto bij “${displayPost.title}”`}
  type="article"
  publishedTime={displayPost.isoDate}
  modifiedTime={displayPost.isoDate}
>
  <PostContent reading={reading} />
  <FurtherReading postId={displayPost.id} />
  <ReactionList reactions={displayPost.reactions} />
</BaseLayout>
