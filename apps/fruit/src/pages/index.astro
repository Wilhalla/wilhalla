---
import { layout, typography } from "@wilhalla/ui/lib/typography";
import { buttonVariants } from "@wilhalla/ui/components/button";
import { cn } from "@wilhalla/ui/lib/utils";
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import ChronologicalFeed from '../components/ChronologicalFeed'
import portraitDaniel from '../assets/portrait_daniel_willaeys.jpg'
import { aggregatedPostIndex } from '../lib/postIndex'
---
<BaseLayout
  title="Chronologische tijdlijn · Blogarchief Daniël Willaeys"
  description="Alle berichten uit het blogarchief van Daniël Willaeys."
>
  <div class="relative w-full overflow-hidden border-b border-chalk bg-eggshell py-14 md:py-18 lg:py-22">
    <div class={cn(layout.container, "grid items-center gap-x-12 gap-y-8 md:grid-cols-[minmax(14rem,0.4fr)_minmax(0,0.6fr)] lg:gap-x-16")}>
      <figure class="order-2 relative mb-0 grid justify-items-center md:order-1 md:row-span-2 md:justify-self-end">
        <Image
          src={portraitDaniel}
          alt="Portret van Daniël Willaeys"
          width={360}
          height={540}
          widths={[180, 240, 320, 360, 480, 640]}
          sizes="(max-width: 767px) 12rem, (max-width: 1023px) 17rem, 20rem"
          layout="constrained"
          format="webp"
          quality="high"
          loading="eager"
          decoding="async"
          class="h-auto w-48 rounded-image bg-powder object-cover md:w-68 lg:w-80"
        />
      </figure>

      <div class="order-1 grid justify-items-center text-center md:order-2 md:self-end md:justify-items-start md:text-left">
        <h1
          id="chronology-title"
          class={cn(typography.display, "max-w-3xl max-md:mx-auto")}
        >
          Blogarchief Daniël Willaeys
        </h1>
      </div>

      <div class="order-3 max-w-2xl justify-self-center text-center md:col-start-2 md:justify-self-start md:self-start md:text-left">
        <p class="m-0 text-body-lg leading-body-lg text-gravel">
          De berichten, foto’s en reacties uit het fruitblog van Daniël Willaeys, van 2005 tot 2020.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-2 md:justify-start">
          <a
            class={cn(buttonVariants(), "gap-2")}
            href="/search/"
          >
            <svg class="size-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            Zoeken
          </a>
          <a
            class="inline-flex min-h-9 items-center gap-2 rounded-full border border-chalk bg-pure-surface px-3 text-body font-medium text-obsidian no-underline shadow-subtle-2 hover:text-obsidian"
            href="/gallery/"
          >
            <svg class="size-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
              <circle cx="9" cy="9" r="2"></circle>
              <path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path>
            </svg>
            Beeldarchief
          </a>
        </div>
      </div>
    </div>
  </div>
  <ChronologicalFeed posts={aggregatedPostIndex} />
</BaseLayout>
