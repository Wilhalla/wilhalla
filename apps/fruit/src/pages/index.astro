---
import { layout, media, typography } from "@wilhalla/ui/lib/typography";
import { buttonVariants } from "@wilhalla/ui/components/button";
import { cn } from "@wilhalla/ui/lib/utils";
import { Image } from 'astro:assets'
import { Images, Search } from 'lucide-react'
import BaseLayout from '../layouts/BaseLayout.astro'
import ChronologicalFeed from '../components/ChronologicalFeed'
import portraitDaniel from '../assets/portrait_daniel_willaeys.jpg'
import { aggregatedPostIndex } from '../lib/postIndex'
---
<BaseLayout
  title="Chronologische tijdlijn · Blogarchief Daniel Willaeys"
  description="Alle berichten uit het blogarchief van Daniel Willaeys."
>
  <div class="relative w-full overflow-hidden border-b border-chalk bg-eggshell py-14 md:py-18 lg:py-22">
    <div class={cn(layout.container, "grid items-center gap-x-12 gap-y-8 md:grid-cols-5 lg:gap-x-16")}>
      <figure class="order-2 relative mb-0 grid justify-items-center md:order-1 md:col-span-2 md:row-span-2 md:justify-self-end">
        <Image
          src={portraitDaniel}
          alt="Portret van Daniel Willaeys"
          width={360}
          height={540}
          widths={[180, 240, 320, 360, 480, 640]}
          sizes="(max-width: 767px) 12rem, (max-width: 1023px) 17rem, 20rem"
          layout="constrained"
          format="webp"
          quality="high"
          loading="eager"
          decoding="async"
          class={cn(media.image, "h-auto w-48 rounded-image md:w-68 lg:w-80")}
        />
      </figure>

      <div class="order-1 grid justify-items-center text-center md:order-2 md:col-span-3 md:self-end md:justify-items-start md:text-left">
        <h1
          id="chronology-title"
          class={cn(typography.display, "max-w-3xl max-md:mx-auto")}
        >
          Blogarchief Daniel Willaeys
        </h1>
      </div>

      <div class="order-3 max-w-2xl justify-self-center text-center md:col-span-3 md:col-start-3 md:justify-self-start md:self-start md:text-left">
        <p class={cn(typography.intro, "m-0")}>
          De berichten, foto’s en reacties uit het fruitblog van Daniel Willaeys, van 2005 tot 2020.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-2 md:justify-start">
          <a class={buttonVariants()} href="/search/">
            <Search strokeWidth={1.5} />Zoeken
          </a>
          <a class={buttonVariants({ variant: "outline" })} href="/gallery/">
            <Images strokeWidth={1.5} />Beeldarchief
          </a>
        </div>
      </div>
    </div>
  </div>
  <ChronologicalFeed posts={aggregatedPostIndex} />
</BaseLayout>
