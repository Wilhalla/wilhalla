---
import BaseLayout from '../../layouts/BaseLayout.astro'
import GalleryApp from '../../components/gallery/GalleryApp'
import initialImages from '../../data/generated/image-index.initial.json'
import galleryGroups from '../../data/generated/gallery-groups.json'
---
<BaseLayout title="Beeldarchief · Blogarchief Daniël Willaeys" description="Alle foto's uit het blogarchief van Daniël Willaeys.">
  <!-- Links from before the viewer had its own page carry the photo as ?img= (or ?image=). -->
  <script is:inline>
    const legacyParams = new URLSearchParams(location.search)
    if (legacyParams.has('img') || legacyParams.has('image')) location.replace(`/gallery/view/${location.search}`)
  </script>
  <GalleryApp initialImages={initialImages} groups={galleryGroups} client:load />
</BaseLayout>
