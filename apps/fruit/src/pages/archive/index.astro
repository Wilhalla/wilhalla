---
import { PageHeader } from "@wilhalla/ui/components/page-header";
import BaseLayout from '../../layouts/BaseLayout.astro'
import ArchiveVirtualList from '../../components/ArchiveVirtualList'
import { archiveStats } from '../../lib/postIndex'
---
<BaseLayout title="Alle berichten · Blogarchief Daniël Willaeys">
  <PageHeader
    size="page"
    title="Alle berichten"
    intro="Elk bericht uit het blog, van het nieuwste naar het oudste. Kies een jaar of een onderwerp om te filteren."
    meta={`${archiveStats.postCount.toLocaleString('nl-BE')} berichten`}
  />
  <ArchiveVirtualList client:load />
</BaseLayout>
