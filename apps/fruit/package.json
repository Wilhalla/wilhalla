{
  "name": "@wilhalla/fruit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "build:compressed": "astro build && pnpm compressStatic",
    "test": "vitest run",
    "preview": "astro preview --host 127.0.0.1",
    "extract": "tsx scripts/extract-archive.ts",
    "materialize": "tsx scripts/materialize-post-files.ts",
    "repairEncoding": "tsx scripts/repair-encoding.ts",
    "prepareData": "pnpm extract && pnpm normalizeTitles && pnpm copyImages && pnpm materialize && pnpm clientData",
    "copyImages": "tsx scripts/copy-images.ts",
    "normalizeTitles": "tsx scripts/normalize-titles.ts",
    "clientData": "tsx scripts/build-client-data.ts",
    "compressStatic": "tsx scripts/compress-static.ts",
    "semanticAtlas": ".venv/bin/python scripts/archive_ml_similarity.py && python3 scripts/archive_ml_publish.py && python3 scripts/topic_calendar.py && tsx scripts/build-client-data.ts",
    "imageAtlas": "python3 scripts/archive_ml_publish_images.py && tsx scripts/chunk-gallery-index.ts",
    "imageAtlas:bg": "nohup sh -c 'python3 scripts/archive_ml_publish_images.py && tsx scripts/chunk-gallery-index.ts' > image-atlas.log 2>&1 & echo $! > image-atlas.pid",
    "speciesAtlas": ".venv/bin/python scripts/species_atlas.py",
    "topicCalendar": ".venv/bin/python scripts/topic_calendar.py",
    "searchIndex": "tsx scripts/build-search-index.ts",
    "galleryChunks": "tsx scripts/chunk-gallery-index.ts",
    "uploadImages": "bash scripts/upload-public-images.sh",
    "uploadImages:bg": "bash scripts/upload-public-images-bg.sh",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "catalog:",
    "@astrojs/vercel": "catalog:",
    "@lucide/astro": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@vercel/analytics": "catalog:",
    "@wilhalla/ui": "workspace:*",
    "astro": "catalog:",
    "cheerio": "catalog:",
    "domhandler": "catalog:",
    "lucide-react": "catalog:",
    "mermaid": "catalog:",
    "minisearch": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:",
    "sharp": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:astro",
    "vitest": "catalog:"
  }
}
